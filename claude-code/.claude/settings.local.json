{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "WebFetch(domain:docs.anthropic.com)",
      "WebSearch",
      "Bash(ls:*)",
      "Bash(xargs:*)"
    ],
    "deny": []
  },
  "outputStyle": "Terse",
  "prefersReducedMotion": true,
  "auto_connect_to_ide": true,
  "enabledPlugins": {
    "hookify@claude-plugins-official": false
  }
}
