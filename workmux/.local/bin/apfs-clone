#!/usr/bin/env python3
# APFS directory clone via clonefile(2). One syscall for the whole tree.
# Usage: apfs-clone <src> <dst>
# Silent no-op if src is missing or dst already exists.

import ctypes
import ctypes.util
import os
import sys


def main() -> int:
    if len(sys.argv) != 3:
        print("usage: apfs-clone <src> <dst>", file=sys.stderr)
        return 2

    src, dst = sys.argv[1], sys.argv[2]
    if not os.path.exists(src) or os.path.exists(dst):
        return 0

    libc = ctypes.CDLL(ctypes.util.find_library("System"), use_errno=True)
    libc.clonefile.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_uint32]
    libc.clonefile.restype = ctypes.c_int

    rc = libc.clonefile(os.fsencode(src), os.fsencode(dst), 0)
    if rc != 0:
        err = ctypes.get_errno()
        print(f"apfs-clone: clonefile failed: {os.strerror(err)}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
